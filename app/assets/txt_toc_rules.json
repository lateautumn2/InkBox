    "rule": "^[ \\t\\u3000]{0,8}\\d{1,5}[ \\t\\u3000]{0,4}$",
    "example": "1 / 002 / 128",
    "serialNumber": 6
  },
  {
    "id": -7,
    "enable": true,
    "name": "英文 Chapter / Part / Section",
    "rule": "(?i)^[ \\t\\u3000]{0,8}(?:chapter|part|section|volume|vol\\.?|book|act|prologue|epilogue)(?:[\\s\\u3000\\-:#.]+[0-9ivxlcdm]+)?(?:[\\s\\u3000:.\\-—].{0,45})?$",
    "example": "Chapter 1 The Beginning / PART II / Prologue",
    "serialNumber": 7
  },
  {
    "id": -8,
    "enable": true,
    "name": "括号序号标题",
    "rule": "^[ \\t\\u3000]{0,8}[(（\\[【][ \\t]{0,2}(?:第?[\\d〇零一二两三四五六七八九十百千万]+[章节回卷话]?|序章|楔子|番外|尾声)[ \\t]{0,2}[)）\\]】].{0,35}$",
