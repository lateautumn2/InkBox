    "rule": "^[ \\t\\u3000]{0,8}(?:第[\\d〇零一二两三四五六七八九十百千万]+(?:卷|部|集|篇)|卷[\\d〇零一二两三四五六七八九十百千]+|正文)[\\s\\u3000·:：\\-]{1,4}.{0,20}?第[\\s\\u3000]{0,3}[\\d０-９〇零一二两三四五六七八九十百千万]+[\\s\\u3000]{0,3}(?:章|节|回).{0,35}$",
    "example": "第一卷 崛起 第一章 初出茅庐",
    "serialNumber": 2
  },
  {
    "id": -3,
    "enable": true,
    "name": "无「第」字章节(卷/章/节/回)",
    "rule": "^[ \\t\\u3000]{0,8}(?:卷|章|节|回|集|部|篇)[\\s\\u3000]{0,2}[\\d０-９〇零一二两三四五六七八九十百千万]+(?:[\\s\\u3000.、:：\\-].{0,35})?$",
    "example": "卷一 尘封往事 / 章十二 暗夜",
    "serialNumber": 3
  },
  {
    "id": -4,
    "enable": true,
    "name": "中文数字序号标题",
    "rule": "^[ \\t\\u3000]{0,8}[〇零一二两三四五六七八九十百千万]{1,7}[、.．:：\\s\\u3000]+[^\\s。，；！？?!]{1,30}$",
    "example": "一、初入江湖 / 十二、夜访",
    "serialNumber": 4
  },
  {
    "id": -5,
    "enable": true,
    "name": "阿拉伯数字分隔符标题",
    "rule": "^[ \\t\\u3000]{0,8}\\d{1,5}[、.．:：\\-—\\s\\u3000]+[^\\d\\s。，；]{1,35}$",
    "example": "1、序幕 / 001. 黎明之前 / 12 - 归途",
    "serialNumber": 5
  },
  {
    "id": -6,
    "enable": true,
